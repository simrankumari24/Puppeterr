{
  "name": "puppeterr",
  "version": "1.0.0",
  "description": "An Ai that searches the web using browsing tools",
  "main": "agent.js",
  "scripts": {
    "start": "xvfb-run -a node agent.js",
    "start:local": "node agent.js",
    "start:legacy": "node index.js",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy",
    "auto:run": "node auto-improve/pipeline.js",
    "auto:orchestrate": "node auto-improve/run_orchestrator.js",
    "auto:issues": "node auto-improve/issue_generator.js",
    "auto:fix": "node auto-improve/fix_orchestrator.js",
    "auto:review": "node auto-improve/review_orchestrator.js",
    "auto:approve": "node auto-improve/auto_approval_engine.js",
    "auto:apply": "node auto-improve/git_patch_applier.js",
    "auto:cli": "node auto-improve/human_cli.js",
    "auto:test": "node auto-improve/test.js",
    "test": "npm run auto:test",
    "strider": "node strider/index.js",
    "strider:bfs": "node strider/index.js --mode bfs",
    "strider:walk": "node strider/index.js --mode random"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simrankumari24/Puppeterr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/simrankumari24/Puppeterr/issues"
  },
  "homepage": "https://github.com/simrankumari24/Puppeterr#readme",
  "dependencies": {
    "@cloudflare/ai": "^1.2.2",
    "@cloudflare/workers-types": "^4.20260629.1",
    "@huggingface/inference": "^4.13.21",
    "agents": "^0.18.0",
    "base64-js": "^1.5.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mustache": "^4.2.0",
    "nodemailer": "^9.0.3",
    "pinch-api": "^0.1.0",
    "playwright": "^1.61.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "^8.5.0"
  }
}
