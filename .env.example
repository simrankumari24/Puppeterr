# Puppeterr runtime defaults (copy to .env and adjust as needed)

# Server
PORT=3000

# Cloudflare AI credentials
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Optional model catalog fallback (used when Cloudflare /ai/models listing is unavailable)
# MODEL_CATALOG_FILE=/workspaces/Puppeterr/model-catalog.txt
# MODEL_CATALOG_TEXT=@cf/qwen/qwen3-30b-a3b-fp8,anthropic/claude-opus-4.8

# Browsing speed/quality cadence
IDLE_HUMAN_MODE=auto
SIMPLE_BROWSING_MODE=auto
SIMPLE_BROWSING_DYNAMIC_UI_FAIL_THRESHOLD=2
SUPERVISOR_SAMPLE_EVERY_STEPS=2
INSTINCT_SAMPLE_EVERY_STEPS=2
VISION_SAMPLE_EVERY_STEPS=2
VERIFY_EVERY_STEPS=2

# Confusion research controls
CONFUSION_RESEARCH_STEP_INTERVAL=6
CONFUSION_RESEARCH_COOLDOWN_MS=180000
CONFUSION_RESEARCH_RESULT_LIMIT=5
CONFUSION_RESEARCH_BLOCKED_HOSTS=google.com,bing.com,duckduckgo.com,search.yahoo.com

# Extracted page-state context limits
STATE_TEXT_LIMIT=6000
STATE_LINK_LIMIT=30
STATE_INPUT_LIMIT=30
STATE_BUTTON_LIMIT=25

# Supervisor behavior
SUPERVISOR_MODE=enforce
SUPERVISOR_BLOCK_SCORE=0.52
SUPERVISOR_WARN_SCORE=0.67
SUPERVISOR_ACTION_BLOCK_RISK=0.72
