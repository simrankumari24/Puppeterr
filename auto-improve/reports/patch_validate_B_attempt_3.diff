+async function createPersistentContext(browserType, baseOptions) {
+  const fs = require('fs').promises;
+  const path = require('path');
+  // Use a timestamped, per-process profile so the persistent context never collides
+  // with a previous Chromium session that is still holding the profile lock.
+  const userDataDir = `${(baseOptions.userDataDir || path.resolve('.puppeterr-profile'))}-${Date.now()}-${process.pid}`;
+  await fs.mkdir(userDataDir, { recursive: true });
+  // Remove any stale Chromium lock files from earlier crashed sessions.
+  for (const lock of ['SingletonLock', 'SingletonCookie']) {
+    try { await fs.unlink(path.join(userDataDir, lock)); } catch {}
+  }
+  return browserType.launchPersistentContext(userDataDir, baseOptions);
+}
