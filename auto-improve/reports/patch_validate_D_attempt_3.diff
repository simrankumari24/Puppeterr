+/**
+ * Ensure the persistent profile directory is usable.
+ *
+ * Playwright's launchPersistentContext reuses the same user-data-dir. If a
+ * previous run crashed or left Chromium's singleton lock behind, reopening the
+ * same profile fails with "Opening in existing browser session." This helper
+ * removes stale locks without deleting the profile contents.
+ */
+async function preparePersistentProfile(profileDir, lockFile) {
+  await fs.mkdir(profileDir, { recursive: true });
+  try {
+    const linkTarget = await fs.readlink(lockFile);
+    const stalePid = Number(path.basename(linkTarget).split('-').pop());
+    if (Number.isInteger(stalePid)) {
+      try {
+        process.kill(stalePid, 0);
+        throw new Error(`Profile lock held by running Chromium pid=${stalePid}`);
+      } catch (err) {
+        if (err.code === 'ESRCH') {
+          await fs.unlink(lockFile).catch(() => {});
+        } else {
+          throw err;
+        }
+      }
+    } else {
+      await fs.unlink(lockFile).catch(() => {});
+    }
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+  }
+}
 
