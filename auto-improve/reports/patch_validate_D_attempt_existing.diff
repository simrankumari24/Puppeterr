+function mergeUniqueArgs(defaultArgs, extraArgs) {
+  // Remove duplicate flags so the Chromium launch log stays readable.
+  const seen = new Set();
+  return [...defaultArgs, ...(extraArgs || [])].filter(arg => {
+    const flag = arg.startsWith('--') ? arg.split('=')[0] : arg;
+    if (seen.has(flag)) return false;
+    seen.add(flag);
+    return true;
+  });
+}
+
+function ensureProfileLockCleared(profileDir) {
+  const fs = require('fs');
+  const path = require('path');
+  const lockFile = path.join(profileDir, 'SingletonLock');
+  if (fs.existsSync(lockFile)) {
+    try {
+      fs.unlinkSync(lockFile);
+    } catch {
+      // Another live Chromium owns the lock; let launch report it.
+    }
+  }
+}
