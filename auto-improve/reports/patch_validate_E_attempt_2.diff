diff --git a/lib/browser-launcher.js b/lib/browser-launcher.js
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/lib/browser-launcher.js
@@ -0,0 +1,75 @@
+const fs = require('fs');
+const path = require('path');
+const { execSync } = require('child_process');
+
+function sleep(ms) {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+function removeProfileLocks(profileDir) {
+  for (const name of ['SingletonLock', 'SingletonCookie', 'SingletonSocket']) {
+    try {
+      fs.rmSync(path.join(profileDir, name), { force: true, maxRetries: 3 });
+    } catch {}
+  }
+}
+
+function killProfileChrome(profileDir) {
+  const escaped = profileDir.replace(/'/g, "'\\''");
+  try {
+    execSync(`pkill -9 -f 'chrome.*--user-data-dir=${escaped}' || true`, { stdio: 'ignore' });
+  } catch {}
+}
+
+function ensureUniqueProfileDir(baseProfileDir) {
+  fs.mkdirSync(baseProfileDir, { recursive: true });
+  const lockPath = path.join(baseProfileDir, 'SingletonLock');
+  if (fs.existsSync(lockPath)) {
+    const alt = `${baseProfileDir}-${Date.now()}-${Math.floor(Math.random() * 1e6)}`;
+    fs.mkdirSync(alt, { recursive: true });
+    return alt;
+  }
+  return baseProfileDir;
+}
+
+async function launchPersistentContextWithRetry(launcher, baseProfileDir, options, maxRetries = 3) {
+  let lastErr;
+  for (let attempt = 0; attempt < maxRetries; attempt++) {
+    const profileDir = ensureUniqueProfileDir(baseProfileDir);
+    removeProfileLocks(profileDir);
+    killProfileChrome(profileDir);
+    await sleep(500 + attempt * 500);
+    try {
+      const context = await launcher.launchPersistentContext(profileDir, options);
+      return context;
+    } catch (err) {
+      lastErr = err;
+      const msg = (err && err.message) || '';
+      if (/existing browser session|profile is already in use|cannot create.*profile/i.test(msg)) {
+        killProfileChrome(profileDir);
+        removeProfileLocks(profileDir);
+        continue;
+      }
+      throw err;
+    }
+  }
+  throw lastErr || new Error('Failed to launch persistent Chromium context after retries');
+}
+
+module.exports = { launchPersistentContextWithRetry, ensureUniqueProfileDir, removeProfileLocks, killProfileChrome, sleep };
+
