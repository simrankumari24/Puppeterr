+++ b/lib/browser-lifecycle.js
@@ -0,0 +1,130 @@
+const fs = require('fs');
+const path = require('path');
+const { spawn, execSync } = require('child_process');
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+const sleepSync = (ms) => { const start = Date.now(); while (Date.now() - start < ms) {} };
+
+function findFreeDisplay() {
+  for (let i = 99; i < 200; i++) {
+    try {
+      execSync(`xdpyinfo -display :${i}`, { stdio: 'ignore' });
+    } catch {
+      return `:${i}`;
+    }
+  }
+  throw new Error('No free X11 display found for Xvfb');
+}
+
+function startXvfb(display) {
+  const xvfb = spawn('Xvfb', [
+    display,
+    '-screen', '0', '1366x768x24',
+    '-ac',
+    '+extension', 'RANDR',
+    '-nolisten', 'tcp'
+  ], { detached: true, stdio: 'ignore' });
+  if (!xvfb.pid) throw new Error('Xvfb failed to start');
+  xvfb.unref();
+  process.env.DISPLAY = display;
+  const deadline = Date.now() + 5000;
+  while (Date.now() < deadline) {
+    try { execSync('xdpyinfo', { stdio: 'ignore' }); return; } catch {}
+    sleepSync(50);
+  }
+  throw new Error(`Xvfb did not become ready on ${display}`);
+}
+
+function ensureXvfb() {
+  if (process.env.DISPLAY) {
+    try { execSync('xdpyinfo', { stdio: 'ignore' }); return; } catch {}
+  }
+  startXvfb(findFreeDisplay());
+}
+
+function cleanupProfileLocks(profilePath) {
+  if (!profilePath || !fs.existsSync(profilePath)) return;
+  for (const name of ['SingletonLock', 'SingletonCookie', 'SingletonSocket']) {
+    const lockPath = path.join(profilePath, name);
+    try {
+      if (fs.existsSync(lockPath)) fs.rmSync(lockPath, { force: true });
+    } catch {}
+  }
+}
+
+function killStaleChrome(profilePath) {
+  try {
+    const abs = path.resolve(profilePath);
+    const out = execSync(`lsof +D '${abs}' | awk 'NR>1 {print $2}' | sort -u`, {
+      encoding: 'utf8',
+      stdio: ['pipe', 'pipe', 'ignore']
+    });
+    for (const pid of out.split('\n').filter(Boolean)) {
+      try { process.kill(Number(pid), 'SIGTERM'); } catch {}
+    }
+  } catch {}
+}
+
+function dedupeArgs(options) {
+  if (!options || !Array.isArray(options.args)) return options;
+  return { ...options, args: [...new Set(options.args)] };
+}
+
+async function launchPersistentContextWithRetry(launcher, profilePath, options, maxAttempts = 3) {
+  ensureXvfb();
+  let lastErr;
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    killStaleChrome(profilePath);
+    cleanupProfileLocks(profilePath);
+    try {
+      return await launcher.launchPersistentContext(profilePath, dedupeArgs(options));
+    } catch (err) {
+      lastErr = err;
+      const msg = err.message || '';
+      if (!/existing browser session|already in use|profile/i.test(msg)) throw err;
+      if (attempt === maxAttempts) break;
+      await sleep(500 + attempt * 250);
+    }
+  }
+  throw lastErr;
+}
+
+module.exports = {
+  ensureXvfb,
+  cleanupProfileLocks,
+  launchPersistentContextWithRetry,
+  dedupeArgs
+};
