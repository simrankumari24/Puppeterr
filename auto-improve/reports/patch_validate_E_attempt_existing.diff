+++ b/test/browser-lifecycle.test.js
@@ -0,0 +1,22 @@
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const { cleanupProfileLocks, dedupeArgs } = require('../lib/browser-lifecycle');
+
+const deduped = dedupeArgs({ headless: false, args: ['--no-sandbox', '--no-sandbox', '--disable-infobars'] });
+assert.deepStrictEqual(deduped.args, ['--no-sandbox', '--disable-infobars']);
+
+const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'puppeterr-test-'));
+for (const name of ['SingletonLock', 'SingletonCookie', 'SingletonSocket']) {
+  fs.writeFileSync(path.join(profile, name), 'lock');
+}
+cleanupProfileLocks(profile);
+assert.strictEqual(fs.readdirSync(profile).length, 0);
+fs.rmSync(profile, { recursive: true, force: true });
+
+console.log('browser-lifecycle startup checks passed');
